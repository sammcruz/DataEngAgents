#!/usr/bin/env bash
# Blocks a commit when the staged files contain ids, e-mails, tenant URLs,
# token-shaped strings or (if .anonymize-denylist.txt exists) private names.
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
# shellcheck disable=SC2086
python3 scripts/check_anonymized.py $files || {
  echo
  echo "Commit blocked: remove the findings above (or sanitise them) and try again."
  exit 1
}
